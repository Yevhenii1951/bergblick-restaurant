---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ScrollReveal from '../../../components/effects/ScrollReveal'
import GradientText from '../../../components/effects/GradientText'
import { getDictionary } from '../../../i18n'
import type { Locale } from '../../../i18n/config'

export async function getStaticPaths() {
  const locales: Locale[] = ['de', 'ru', 'en']
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const dict = getDictionary(locale)
---

<BaseLayout locale={locale} title={dict.legal.datenschutz}>
  <section class="texture-wood bg-base-100">
    <div class="mx-auto max-w-3xl px-6 py-16 md:py-24">
      <ScrollReveal>
        <div class="text-center">
          <p class="font-script text-2xl text-primary md:text-3xl">{dict.tagline}</p>
          <h1 class="mt-2 text-4xl font-semibold md:text-5xl">
            <GradientText>{dict.legal.datenschutz}</GradientText>
          </h1>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={150}>
        <div class="mt-10 rounded-xl border border-base-300 bg-base-100 p-8 shadow-sm">
          <h2 class="font-display text-xl font-semibold">1. Datenschutz auf einen Blick</h2>
          <p class="mt-3 text-base-content/80">
            Diese Website ist ein Trainingsprojekt. Es werden keine personenbezogenen Daten
            dauerhaft gespeichert. Strukturierte Daten (z. B. Bestellungen im Takeaway) werden
            ausschließlich zur Demo an die konfigurierte Telegram-Adresse übertragen.
          </p>

          <h2 class="mt-8 font-display text-xl font-semibold">2. Karten und externe Dienste</h2>
          <p class="mt-3 text-base-content/80">
            Die Standortkarte (OpenStreetMap) wird erst nach Ihrer Zustimmung über die
            Cookie-Abfrage geladen. Erst dann werden Daten an den Kartendienst übertragen.
          </p>

          <h2 class="mt-8 font-display text-xl font-semibold">3. Ihre Rechte</h2>
          <p class="mt-3 text-base-content/80">
            Sie haben das Recht auf Auskunft, Berichtigung und Löschung Ihrer Daten. Wenden Sie
            sich dafür an die im Impressum genannten Kontaktdaten.
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
