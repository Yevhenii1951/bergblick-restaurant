---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import CartPage from '../../../components/cart/CartPage'
import ScrollReveal from '../../../components/effects/ScrollReveal'
import GradientText from '../../../components/effects/GradientText'
import { getDictionary } from '../../../i18n'
import type { Locale } from '../../../i18n/config'

export async function getStaticPaths() {
  const locales: Locale[] = ['de', 'ru', 'en']
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const dict = getDictionary(locale)
---

<BaseLayout locale={locale} title={dict.takeaway.cart}>
  <section class="texture-wood bg-base-100">
    <div class="mx-auto max-w-5xl px-6 py-16 md:py-20">
      <ScrollReveal>
        <div class="text-center">
          <p class="section-kicker font-script text-2xl md:text-3xl">{dict.tagline}</p>
          <h1 class="mt-2 text-4xl font-semibold md:text-5xl">
            <GradientText>{dict.takeaway.cart}</GradientText>
          </h1>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={150}>
        <div class="mt-10">
          <CartPage dict={dict} client:only="react" />
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>
