---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ReservationForm from '../../../components/ReservationForm'
import { getDictionary } from '../../../i18n'
import type { Locale } from '../../../i18n/config'

export async function getStaticPaths() {
  const locales: Locale[] = ['de', 'ru', 'en']
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const dict = getDictionary(locale)
---

<BaseLayout locale={locale} title={dict.reservation.title}>
  <div class="mx-auto max-w-xl px-6 py-16">
    <h1 class="text-3xl font-bold">{dict.reservation.title}</h1>
    <p class="mt-2 text-base-content/70">{dict.reservation.subtitle}</p>
    <div class="mt-8">
      <ReservationForm dict={dict} client:visible />
    </div>
  </div>
</BaseLayout>
