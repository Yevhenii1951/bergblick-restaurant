---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import LocationMap from '../../../components/LocationMap.tsx'
import ScrollReveal from '../../../components/effects/ScrollReveal'
import GradientText from '../../../components/effects/GradientText'
import { getDictionary } from '../../../i18n'
import { SITE } from '../../../lib/config'
import type { Locale } from '../../../i18n/config'

export async function getStaticPaths() {
  const locales: Locale[] = ['de', 'ru', 'en']
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const dict = getDictionary(locale)
---

<BaseLayout locale={locale} title={dict.contact.title}>
  <section class="texture-wood bg-base-100">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
      <ScrollReveal>
        <div class="mx-auto mb-12 max-w-2xl text-center">
          <p class="font-script text-2xl text-primary md:text-3xl">{dict.tagline}</p>
          <h1 class="mt-2 text-4xl font-semibold md:text-5xl">
            <GradientText>{dict.contact.title}</GradientText>
          </h1>
        </div>
      </ScrollReveal>

      <div class="grid gap-8 lg:grid-cols-2 lg:h-96">
        <ScrollReveal delay={120} className="h-full">
          <section class="h-full flex flex-col justify-center rounded-xl border border-base-300 bg-base-100 p-6 shadow-sm">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <span class="grid h-9 w-9 place-items-center rounded-lg bg-primary/10 text-neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                  <h2 class="font-display font-semibold">{dict.contact.address}</h2>
                </div>
                <p class="mt-2 text-sm text-base-content/80">{SITE.address.street}<br />{SITE.address.city}</p>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="grid h-9 w-9 place-items-center rounded-lg bg-accent/10 text-neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                  <h2 class="font-display font-semibold">{dict.contact.hours}</h2>
                </div>
                <p class="mt-2 text-sm text-base-content/80">{SITE.hours}</p>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="grid h-9 w-9 place-items-center rounded-lg bg-secondary/10 text-neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>
                  <h2 class="font-display font-semibold">{dict.contact.phone}</h2>
                </div>
                <a class="mt-2 inline-block text-sm font-semibold text-primary hover:underline" href={`tel:${SITE.phone}`}>
                  {SITE.phone}
                </a>
              </div>
            </div>
          </section>
        </ScrollReveal>

        <ScrollReveal delay={240} direction="left" className="h-full">
          <LocationMap dict={dict} client:only="react" />
        </ScrollReveal>
      </div>
    </div>
  </section>
</BaseLayout>
