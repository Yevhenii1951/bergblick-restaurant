---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getDictionary } from '../../../i18n'
import type { Locale } from '../../../i18n/config'

export async function getStaticPaths() {
  const locales: Locale[] = ['de', 'ru', 'en']
  return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params as { locale: Locale }
const dict = getDictionary(locale)
---

<BaseLayout locale={locale} title={dict.about.title}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-bold">{dict.about.title}</h1>
    <div class="mt-6 space-y-4 card bg-base-200 p-6">
      <p>{dict.about.body}</p>
    </div>
  </div>
</BaseLayout>
