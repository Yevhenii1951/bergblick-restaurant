---
import type { Dictionary } from '../../i18n/types'
import DishCard from '../cart/DishCard'
import ScrollReveal from '../effects/ScrollReveal'

interface Dish {
  id: string
  name: string
  description: string
  price: number
  vegetarian: boolean
  image?: string
}

interface Props {
  dict: Dictionary
  sectionKey: string
  sectionName: string
  dishes: Dish[]
}

const { dict, sectionKey, sectionName, dishes } = Astro.props
---

<section class="mb-14" id={sectionKey}>
  <div class="mb-6 flex items-end justify-between gap-4 border-b border-base-300 pb-3">
    <div>
      <h2 class="font-display text-2xl font-semibold md:text-3xl">{sectionName}</h2>
    </div>
    <span aria-hidden="true" class="font-script text-2xl text-accent/70">✦</span>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {dishes.map((dish, i) => (
      <ScrollReveal delay={(i % 3) * 80} className="h-full">
        <DishCard
          id={dish.id}
          name={dish.name}
          description={dish.description}
          price={dish.price}
          vegetarian={dish.vegetarian}
          image={dish.image}
          vegLabel={dict.menu.vegetarian}
          addToCartLabel={dict.menu.addToCart}
          client:visible
        />
      </ScrollReveal>
    ))}
  </div>
</section>
