---
import type { Dictionary } from '../../i18n/types'
import AddToCartButton from '../cart/AddToCartButton'

interface Props {
  dict: Dictionary
  sectionName: string
  dishes: {
    id: string
    name: string
    description: string
    price: number
    vegetarian: boolean
    image?: string
  }[]
}

const { dict, sectionName, dishes } = Astro.props
---

<div class="mb-10">
  <h2 class="text-2xl font-bold text-primary">{sectionName}</h2>
  <div class="mt-4 grid gap-4 md:grid-cols-2">
    {dishes.map((dish) => (
      <div class="card card-side bg-base-200 shadow-sm">
        {dish.image && (
          <figure class="w-32 shrink-0">
            <img
              src={dish.image}
              alt={dish.name}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </figure>
        )}
        <div class="card-body py-4">
          <div class="flex items-start justify-between gap-2">
            <h3 class="card-title text-base">{dish.name}</h3>
            <span class="font-bold whitespace-nowrap">{dish.price.toFixed(2)} €</span>
          </div>
          <p class="text-sm text-base-content/70">{dish.description}</p>
          <div class="card-actions mt-2 items-center justify-between">
            {dish.vegetarian && (
              <span class="badge badge-accent badge-sm">{dict.menu.vegetarian}</span>
            )}
            <AddToCartButton
              dishId={dish.id}
              name={dish.name}
              price={dish.price}
              label={dict.menu.addToCart}
              client:visible
            />
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
