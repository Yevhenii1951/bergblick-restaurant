---
import type { Dictionary } from '../../i18n/types'
import ScrollReveal from '../effects/ScrollReveal'
import GradientText from '../effects/GradientText'

interface Props {
  dict: Dictionary
}

const { dict } = Astro.props

const icons = [
  /* soup */ '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11h16a1 1 0 0 1 1 1 8 8 0 0 1-18 0 1 1 0 0 1 1-1z"/><path d="M7 19h10"/><path d="M7 4c.5 1 1.5 1 2 2"/><path d="M11 4c.5 1 1.5 1 2 2"/><path d="M15 4c.5 1 1.5 1 2 2"/><path d="M5 15h1"/></svg>',
  /* salad */ '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 22 22 2"/><path d="M11 6a7 7 0 0 1 7 7"/><path d="M14 10a3 3 0 0 1 3 3"/><path d="M8.5 9 5 12.5 7.5 15"/><path d="M4 16h16l-2 5H6z"/></svg>',
  /* cocktail */ '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h14l-7 8z"/><path d="M12 11v8"/><path d="M8 21h8"/></svg>',
]
---

<section class="texture-wood bg-base-100 py-20">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-kicker font-script text-2xl">{dict.tagline}</p>
      <h2 class="mt-1 text-3xl font-semibold md:text-4xl">
        <GradientText>{dict.highlights.title}</GradientText>
      </h2>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {dict.highlights.items.map((item, i) => (
        <ScrollReveal delay={i * 120} className="h-full">
          <div class="h-full rounded-xl border border-base-300 bg-base-100 p-7 shadow-sm transition-shadow hover:shadow-lg">
            <span class="grid h-14 w-14 place-items-center rounded-lg bg-base-200 text-2xl text-neutral" set:html={icons[i % icons.length]} />
            <h3 class="mt-5 font-display text-xl font-semibold">{item.title}</h3>
            <p class="mt-2 text-base-content/70">{item.text}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
