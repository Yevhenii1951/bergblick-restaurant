---
import type { Dictionary } from '../../i18n/types'
import type { Locale } from '../../i18n/config'
import MenuSection from './MenuSection.astro'
import type { LocalizedSection } from '../../lib/menu'

interface Props {
  dict: Dictionary
  locale: Locale
  sections: LocalizedSection[]
}

const { dict, locale, sections } = Astro.props
---

<section class="bg-base-200 py-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold">{dict.menu.previewTitle}</h2>
        <p class="mt-2 text-base-content/70">{dict.menu.intro}</p>
      </div>
      <a href={`/${locale}/menu/`} class="text-sm font-semibold text-primary hover:underline">
        {dict.menu.previewCta} →
      </a>
    </div>
    <div class="mt-8">
      {sections.map((section) => (
        <MenuSection
          dict={dict}
          sectionKey={section.key}
          sectionName={section.name}
          dishes={section.dishes.slice(0, 3)}
        />
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href={`/${locale}/menu/`} class="btn btn-primary btn-lg rounded-full px-8">
        {dict.menu.previewTitle} →
      </a>
    </div>
  </div>
</section>
