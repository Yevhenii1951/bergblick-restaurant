---
import type { Dictionary } from '../../i18n/types'
import { locales, localeNames, type Locale } from '../../i18n/config'
import CartController from '../cart/CartController'

interface Props {
  dict: Dictionary
  locale: Locale
  pathname: string
}

const { dict, locale, pathname } = Astro.props

function stripLocale(p: string): string {
  const parts = p.split('/')
  if (parts[1] && locales.includes(parts[1] as Locale)) {
    return '/' + parts.slice(2).join('/')
  }
  return p
}

const base = stripLocale(pathname) || '/'

const navItems = [
  { label: dict.nav.home, href: `/${locale}/` },
  { label: dict.nav.menu, href: `/${locale}/menu/` },
  { label: dict.nav.about, href: `/${locale}/about/` },
  { label: dict.nav.contact, href: `/${locale}/contact/` },
]
---

<header class="sticky top-0 z-[300] border-b border-base-300/70 bg-base-100/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6">
    <a href={`/${locale}/`} class="group flex items-center gap-2">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-primary text-primary-content shadow">
        <span aria-hidden="true" class="font-display text-lg font-black leading-none">B</span>
      </span>
      <span class="leading-none">
        <span class="block font-display text-2xl font-semibold">Bergblick</span>
        <span class="font-script text-lg leading-none text-accent">Restaurant &middot; Kassel</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-base-content/80 transition-colors hover:bg-base-200 hover:text-base-content"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm">
          <span aria-hidden="true">🌐</span>
          <span class="uppercase">{localeNames[locale]}</span>
        </div>
        <ul tabindex="0" class="dropdown-content menu z-[400] mt-2 w-40 rounded-box border border-base-300 bg-base-100 shadow-xl">
          {locales.map((l) => (
            <li>
              <a href={`/${l}${base}`} class={l === locale ? 'font-semibold text-primary' : ''}>
                {localeNames[l]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <a href={`/${locale}/takeaway/`} class="btn btn-primary btn-sm hidden md:inline-flex">
        {dict.nav.takeaway}
      </a>

      <CartController dict={dict} checkoutHref={`/${locale}/takeaway/`} client:visible />
    </div>
  </nav>
</header>
